{
  "name": "nlp-service",
  "version": "1.0.0",
  "description": "Worker assíncrono de NLP, Chunking Markdown, Geração de Embeddings 768d e Cache Redis",
  "main": "dist/worker.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/worker.js",
    "dev": "tsx watch src/worker.ts",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --coverage"
  },
  "dependencies": {
    "@shared/contracts": "*",
    "amqplib": "^0.10.4",
    "dotenv": "^16.4.5",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.4.1",
    "pg": "^8.11.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
