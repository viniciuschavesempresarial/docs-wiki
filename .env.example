# ==========================================
# INFRAESTRUTURA GERAL & PORTAS EXTERNAS
# ==========================================
DOMAIN_NAME=docswiki.homelab
HTTP_PORT=80
HTTPS_PORT=443

# ==========================================
# BANCO DE DADOS (POSTGRESQL + PGVECTOR)
# ==========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=docswiki_db
POSTGRES_USER=db_admin
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA

# Usuários específicos por Schema
IAM_DB_USER=iam_user
IAM_DB_PASSWORD=TROQUE_ESTA_SENHA
CONTENT_DB_USER=content_user
CONTENT_DB_PASSWORD=TROQUE_ESTA_SENHA
SEARCH_DB_USER=search_user
SEARCH_DB_PASSWORD=TROQUE_ESTA_SENHA

# ==========================================
# MENSAGERIA & CACHE
# ==========================================
RABBITMQ_DEFAULT_USER=rabbit_admin
RABBITMQ_DEFAULT_PASS=TROQUE_ESTA_SENHA
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

REDIS_PASSWORD=TROQUE_ESTA_SENHA
REDIS_PORT=6379

# ==========================================
# AUTENTICAÇÃO & SEGURANÇA (IAM)
# ==========================================
# Gere um segredo forte: openssl rand -base64 32
JWT_SECRET=TROQUE_POR_UM_SEGREDO_ALEATORIO_FORTE
JWT_EXPIRATION=8h
COOKIE_SECRET=TROQUE_POR_UM_SEGREDO_ALEATORIO_FORTE
ADMIN_INITIAL_EMAIL=admin@docswiki.local
ADMIN_INITIAL_PASSWORD=TROQUE_ESTA_SENHA

# ==========================================
# INTELIGÊNCIA ARTIFICIAL (GEMINI & LOCAL)
# ==========================================
# Obtenha sua chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=SUA_GEMINI_API_KEY_AQUI
# Modelos disponíveis: gemini-2.0-flash | gemini-2.5-flash | gemini-2.5-pro | gemini-3.5-flash
GEMINI_MODEL=gemini-2.0-flash
SENTENCE_TRANSFORMER_MODEL=paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIMENSIONS=768

# ==========================================
# OBSERVABILIDADE & MONITORAMENTO (ISOLADO)
# ==========================================
# Metadados de Identificação para Observabilidade Multi-Projeto (Tags & Labels)
MONITORING_PROJECT=docs-wiki
MONITORING_ENVIRONMENT=staging
MONITORING_NODE_ROLE=staging-target
MONITORING_HOST=staging-target-node01

# Endereço IP ou hostname do nó de monitoramento (use host.docker.internal para Docker local ou IP da VM remota)
VICTORIAMETRICS_HOST=host.docker.internal
VICTORIAMETRICS_PORT=8428
LOKI_HOST=host.docker.internal
LOKI_PORT=3100
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=TROQUE_ESTA_SENHA
